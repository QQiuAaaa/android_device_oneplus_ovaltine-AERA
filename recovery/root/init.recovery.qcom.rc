import /init.recovery.qcom_decrypt.rc
import /init.recovery.wifi.rc

service aera-graphics-allocator /vendor/bin/hw/vendor.qti.hardware.display.allocator-service
    class hal
    user root
    group root graphics
    capabilities SYS_NICE
    seclabel u:r:recovery:s0

# AERA's protected audio bridge uses Ovaltine's matching stock PAL/AGM runtime.
service aera-pd-mapper /system/bin/linker64 /system/aera-audio-vendor/bin/pd-mapper
    class core
    disabled
    user system
    group system
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /system/aera-audio-system-lib64:/system/aera-audio-vendor/lib64:/system/lib64

service aera-dspservice /system/bin/linker64 /system/aera-audio-vendor/bin/dspservice
    class hal
    disabled
    user system
    group system wakelock oem_2908
    capabilities BLOCK_SUSPEND
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /system/aera-audio-system-lib64:/system/aera-audio-vendor/lib64:/system/lib64
    interface aidl vendor.qti.hardware.dsp.IDspService/default

service aera-audioadsprpcd /system/bin/linker64 /system/aera-audio-vendor/bin/audioadsprpcd audiopd
    class main
    disabled
    user media
    group media
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /system/aera-audio-system-lib64:/system/aera-audio-vendor/lib64:/system/lib64

service aera-agm-service /system/bin/aera-audio-service --ovaltine-stock-audio
    class main
    disabled
    user root
    group root system audio media wakelock
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /system/aera-audio-system-lib64:/system/aera-audio-vendor/lib64:/system/lib64
    setenv ANDROID_ROOT /system
    setenv ANDROID_DATA /data

service aera-audio-bootstrap /system/bin/aera-audio-bootstrap
    class core
    disabled
    oneshot
    user root
    group root system audio media wakelock
    seclabel u:r:recovery:s0

on early-init
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1

on init
    write /sys/class/backlight/panel0-backlight/brightness 200

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

    # Load ADSP firmware for PMIC
    mkdir /firmware
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro
    # KGSL uses the direct firmware loader. Prefer the bundled Adreno
    # payloads instead of the modem vfat mount under recovery SELinux.
    write /sys/module/firmware_class/parameters/path /vendor/firmware

on post-fs
    start boot-hal-1-2

on property:twrp.modules.loaded=true && property:dev.mnt.blk.firmware=*
    # Load ADSP firmware for PMIC
    wait /sys/kernel/boot_adsp/boot
    write /sys/kernel/boot_adsp/boot 1
    wait /sys/class/power_supply/battery
    start health-hal-2-1

on property:ro.twrp.fastbootd=1
    # Load ADSP firmware for PMIC
    wait /sys/kernel/boot_adsp/boot
    write /sys/kernel/boot_adsp/boot 1
    wait /sys/class/power_supply/battery
    start health-hal-2-1
    umount /firmware

on post-fs
    start variant-script
    start vendor.oplus.vibrator

on property:post.decrypt.modules=true
    start aera-audio-bootstrap	